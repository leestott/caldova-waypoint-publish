# Local mode never impersonates an Entra sign-in or connects to Microsoft 365.
WAYPOINT_MODE=local
PORT=3978
HOST=127.0.0.1
# Optional durable local path. Container deployment uses a private Blob snapshot
# with a managed-identity client ID instead; no storage keys or SAS URLs.
# WAYPOINT_DATABASE=/home/waypoint/waypoint.sqlite3
# WAYPOINT_STATE_BLOB_URL=https://<account>.blob.core.windows.net/waypoint-state/waypoint.sqlite3
# AZURE_CLIENT_ID=<assigned-managed-identity-client-id>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLOW_SHARED_SECRET=
# Use real tenant object IDs only in your untracked .env, never in source.
TENANT_ID=
FINANCE_PILOT_OIDS=
FINANCE_APPROVER_OIDS=
FINANCE_CHANNEL_ID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__GRAPH__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=teams_sso
# Package configuration. All four must be set for a tenant upload package.
APP_ID=
BOT_ID=
BOT_DOMAIN=
APP_BASE_URL=

# Deployment only: supply YOUR tenant, subscription and signed-in operator.
# Local setup does not require these fields and never provisions resources.
AZURE_SUBSCRIPTION_ID=
DEPLOYMENT_USER_PRINCIPAL_NAME=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
DEPLOYMENT_PREFIX=waypoint
# Optional name overrides; blank derives names from the prefix and target.
AZURE_BOT_NAME=
AZURE_CONTAINER_APP_NAME=
AZURE_CONTAINER_ENVIRONMENT=
AZURE_CONTAINER_REGISTRY=
AZURE_STORAGE_ACCOUNT=
AZURE_MANAGED_IDENTITY_NAME=
AZURE_WORKFLOW_NAME=
AZURE_TEAMS_CONNECTION_NAME=
APP_REGISTRATION_NAME=
FINANCE_PILOT_GROUP_NAME=
FINANCE_TEAM_NAME=
FINANCE_CHANNEL_NAME=
BOT_OAUTH_CONNECTION_NAME=teams_sso
BOT_TOKEN_STORE_NAME=
# Optional legacy App Service path; the documented deployment uses Container Apps.
AZURE_WEB_APP_NAME=
AZURE_APP_SERVICE_PLAN=
